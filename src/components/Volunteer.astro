---
import Section from "./Section.astro";
import type { VolunteerProps } from "@types";

interface Props {
  volunteer: VolunteerProps[];
}

const { volunteer } = Astro.props;
---

<Section text="Leadership Experience" href="leadership">
  <div class="relative space-y-12">
    {
      volunteer.map(({ organization, position, startDate, endDate, summary }) => (
        <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-[#121820]/60 p-6 sm:p-8 transition-all duration-300 hover:border-primary/30 hover:bg-[#161d27]/80">
          <div class="absolute -top-16 -right-16 h-56 w-56 rounded-full bg-primary/10 blur-3xl pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-[240px_1fr] md:gap-8">
            {/* Left Column: Timeline / Meta */}
            <div class="flex flex-col justify-start border-b border-white/5 pb-4 md:border-b-0 md:border-r md:border-white/10 md:pb-0 md:pr-6">
              <span class="mb-2 inline-self-start inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary border border-primary/20">
                {startDate} — {endDate}
              </span>
              <h3 class="font-serif text-2xl font-bold text-white">
                {organization}
              </h3>
            </div>

            {/* Right Column: Content */}
            <div class="flex flex-col">
              <h4 class="mb-4 font-serif text-2xl font-semibold text-primary">
                {position}
              </h4>
              {Array.isArray(summary) ? (
                <ul class="space-y-3">
                  {summary.map((log) => (
                    <li class="flex items-start gap-3 text-base leading-relaxed text-neutral">
                      <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-primary">
                        ✓
                      </span>
                      <span>{log}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-base leading-relaxed text-neutral">{summary}</p>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
