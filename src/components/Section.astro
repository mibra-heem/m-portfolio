---
interface Props {
  text: string;
  href: string;
  class?: string;
  titleMb?: string;
}

const { text, href, class: className = "py-16", titleMb = "mb-10" } = Astro.props;
---

<section id={href} class={className}>
  <h2
    class={`font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl ${titleMb}`}
  >
    {text}
  </h2>
  <slot />
</section>
