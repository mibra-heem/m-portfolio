---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="relative flex flex-col gap-10">
    {
      projects.map(
        (
          { name, subtitle, summary, image, tags, linkPreview, linkSource, linkPlayStore, linkAppStore },
          index,
        ) => {
          const topOffset = 80 + index * 14;
          const projectNum = (index + 1).toString().padStart(2, "0");

          return (
            <div
              style={`top: ${topOffset}px;`}
              class="sticky rounded-3xl border border-white/10 bg-[#141b24]/95 shadow-2xl backdrop-blur-xl transition-all duration-500 hover:border-primary/40 group overflow-hidden"
            >
              {/* Top Right Ambient Glow */}
              <div class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-primary/15 blur-3xl pointer-events-none group-hover:bg-primary/25 transition-all duration-500"></div>
              <div class="relative z-[1] grid grid-cols-1 gap-8 p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-center md:h-[430px]">
                
                {/* Left Column: Text & Content */}
                <div class="flex flex-col justify-between h-full py-1">
                  <div>
                    {/* Number Badge & Title */}
                    <div class="flex items-center gap-3 mb-2">
                      <span class="font-mono text-xs font-bold text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full">
                        {projectNum} / {projects.length.toString().padStart(2, "0")}
                      </span>
                    </div>

                    {/* Clean Title */}
                    <h3 class="font-serif text-3xl font-bold text-white group-hover:text-primary transition-colors">
                      {name}
                    </h3>

                    {/* Distinct Subtitle */}
                    {subtitle && (
                      <p class="mb-3 font-sans text-sm font-semibold tracking-wide text-primary">
                        {subtitle}
                      </p>
                    )}

                    {/* Fixed Summary paragraph line clamp */}
                    <p class="mb-4 text-base leading-relaxed text-neutral md:line-clamp-3">
                      {summary}
                    </p>
                  </div>

                  {/* Tags & Action Links */}
                  <div>
                    {/* Tech Stack Tags */}
                    {tags && tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-6">
                        {tags.map((tag) => (
                          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary border border-primary/20">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Action Links */}
                    <div class="flex flex-wrap items-center gap-3 pt-2 text-sm font-semibold text-white">
                      {linkPlayStore && (
                        <a
                          href={linkPlayStore}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full bg-emerald-600/90 border border-emerald-500/40 px-5 py-2.5 text-xs text-white shadow-lg shadow-emerald-600/20 transition-all duration-300 hover:bg-emerald-500 hover:shadow-emerald-500/40"
                        >
                          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.37 2.37 0 0 1-.61-1.583V3.397c0-.6.22-1.15.609-1.583zm11.3 11.3l2.366 2.366-12.09 7.02 9.724-9.386zm0-2.228L5.185 1.5l12.09 7.02-2.366 2.366zm1.189 1.114l3.82 2.215a1.2 1.2 0 0 1 0 2.07l-3.82 2.215-2.228-2.228 2.228-2.272z"/>
                          </svg>
                          <span>Google Play</span>
                        </a>
                      )}

                      {linkAppStore && (
                        <a
                          href={linkAppStore}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full bg-sky-600/90 border border-sky-500/40 px-5 py-2.5 text-xs text-white shadow-lg shadow-sky-600/20 transition-all duration-300 hover:bg-sky-500 hover:shadow-sky-500/40"
                        >
                          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.66-.8 1.11-1.92.99-3.04-.96.04-2.12.64-2.8 1.44-.61.71-1.14 1.86-1 2.96 1.07.08 2.15-.55 2.81-1.36z"/>
                          </svg>
                          <span>App Store</span>
                        </a>
                      )}

                      {linkSource && (
                        <a
                          href={linkSource}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-xs text-white transition-all duration-300 hover:border-primary hover:bg-primary hover:text-white"
                        >
                          <span>Source Code</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5" />
                        </a>
                      )}

                      {linkPreview && (
                        <a
                          href={linkPreview}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-xs text-white shadow-lg shadow-primary/20 transition-all duration-300 hover:bg-blue-600 hover:shadow-primary/40"
                        >
                          <span>App Demo</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>

                {/* Right Column: Square Image Showcase */}
                <div class="flex items-center justify-center">
                  {image ? (
                    <div class="relative h-64 w-full md:h-80 md:w-80 lg:h-84 lg:w-84 aspect-square overflow-hidden rounded-2xl border border-white/10 bg-black/60 p-2 shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]">
                      <Image
                        class="h-full w-full rounded-xl object-cover"
                        src={image}
                        alt={name}
                        width="400"
                        height="400"
                      />
                    </div>
                  ) : (
                    <div class="relative flex h-64 w-full md:h-80 md:w-80 lg:h-84 lg:w-84 aspect-square flex-col items-center justify-center rounded-2xl border border-dashed border-primary/30 bg-gradient-to-br from-primary/10 via-black/50 to-neutral-900/80 p-6 text-center shadow-xl">
                      <div class="mb-3 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/20 text-primary border border-primary/30 shadow-lg shadow-primary/10">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <span class="font-serif text-lg font-semibold text-white">{name}</span>
                      <span class="mt-1 text-xs font-mono text-primary/80">Square Image Reserved</span>
                    </div>
                  )}
                </div>

              </div>
            </div>
          );
        },
      )
    }
  </div>
</Section>
