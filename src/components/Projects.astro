---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects" class="pt-8 pb-14" titleMb="mb-8">
  <div class="relative flex flex-col gap-10">
    {
      projects.map(
        (
          { name, subtitle, summary, image, tags, linkPreview, linkSource, linkPlayStore, linkAppStore },
          index,
        ) => {
          const topOffset = 80 + index * 14;
          const projectNum = (index + 1).toString().padStart(2, "0");

          return (
            <div
              style={`top: ${topOffset}px;`}
              class="sticky rounded-3xl border border-white/10 bg-[#141b24]/95 shadow-2xl backdrop-blur-xl transition-all duration-500 hover:border-primary/40 group overflow-hidden"
            >
              {/* Top Right Ambient Glow */}
              <div class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-primary/15 blur-3xl pointer-events-none group-hover:bg-primary/25 transition-all duration-500"></div>
              <div class="relative z-[1] grid grid-cols-1 gap-8 p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-center md:h-[430px]">
                
                {/* Left Column: Text & Content */}
                <div class="flex flex-col justify-between h-full py-1">
                  <div>
                    {/* Number Badge & Title */}
                    <div class="flex items-center gap-3 mb-2">
                      <span class="font-mono text-xs font-bold text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full">
                        {projectNum} / {projects.length.toString().padStart(2, "0")}
                      </span>
                    </div>

                    {/* Clean Title */}
                    <h3 class="font-serif text-3xl font-bold text-white group-hover:text-primary transition-colors">
                      {name}
                    </h3>

                    {/* Distinct Subtitle */}
                    {subtitle && (
                      <p class="mb-3 font-sans text-sm font-semibold tracking-wide text-primary">
                        {subtitle}
                      </p>
                    )}

                    {/* Fixed Summary paragraph line clamp */}
                    <p class="mb-4 text-base leading-relaxed text-neutral md:line-clamp-3">
                      {summary}
                    </p>
                  </div>

                  {/* Tags & Action Links */}
                  <div>
                    {/* Tech Stack Tags */}
                    {tags && tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-6">
                        {tags.map((tag) => (
                          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary border border-primary/20">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Action Links */}
                    <div class="flex flex-wrap items-center gap-3 pt-2 text-sm font-semibold text-white">
                      {linkPlayStore && (
                        <a
                          href={linkPlayStore}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-[#0d221a] px-4 py-2.5 text-xs text-white shadow-lg shadow-emerald-950/40 transition-all duration-300 hover:border-emerald-400 hover:bg-[#133025] hover:scale-[1.03]"
                        >
                          <svg class="h-4 w-4 shrink-0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                            <path fill="#41A5EE" d="M99.47 16.59A41.6 41.6 0 0 0 85 49.88v412.24a41.6 41.6 0 0 0 14.47 33.29l21.24-21.24L337.89 257 120.71 39.83z"/>
                            <path fill="#FFD400" d="M410.87 220.89L337.89 257l72.98 36.11 50.19-28.71a41.56 41.56 0 0 0 0-74.8z"/>
                            <path fill="#00E676" d="M120.71 39.83L337.89 257l72.98-36.11L155.6 15.65a41.67 41.67 0 0 0-34.89 24.18z"/>
                            <path fill="#FF3D00" d="M120.71 474.17A41.67 41.67 0 0 0 155.6 498.35l255.27-146.24L337.89 257z"/>
                          </svg>
                          <span>Google Play</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5 opacity-80" />
                        </a>
                      )}

                      {linkAppStore && (
                        <a
                          href={linkAppStore}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-[#0f2132] px-4 py-2.5 text-xs text-white shadow-lg shadow-sky-950/40 transition-all duration-300 hover:border-sky-400 hover:bg-[#152e46] hover:scale-[1.03]"
                        >
                          <svg class="h-4 w-4 shrink-0 fill-current text-white" viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg">
                            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-91.9-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 72.8 26.6.6 51.4-14.7 69.5-35.2z"/>
                          </svg>
                          <span>App Store</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5 opacity-80" />
                        </a>
                      )}

                      {linkSource && (
                        <a
                          href={linkSource}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-xs text-white transition-all duration-300 hover:border-primary hover:bg-primary hover:text-white hover:scale-[1.03]"
                        >
                          <span>Source Code</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5 opacity-80" />
                        </a>
                      )}

                      {linkPreview && (
                        <a
                          href={linkPreview}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2.5 text-xs text-white shadow-lg shadow-primary/20 transition-all duration-300 hover:bg-blue-600 hover:shadow-primary/40 hover:scale-[1.03]"
                        >
                          <span>App Demo</span>
                          <img src="/external.svg" alt="external" class="h-3.5 w-3.5 opacity-80" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>

                {/* Right Column: Square Image Showcase */}
                <div class="flex items-center justify-center">
                  {image ? (
                    <div class="relative h-64 w-full md:h-80 md:w-80 lg:h-84 lg:w-84 aspect-square overflow-hidden rounded-2xl border border-white/15 bg-[#0b0f14] p-2 shadow-2xl transition-all duration-500 group-hover:scale-[1.02] group-hover:border-primary/40">
                      <Image
                        class="h-full w-full rounded-xl object-cover"
                        src={image}
                        alt={name}
                        width="400"
                        height="400"
                      />
                    </div>
                  ) : (
                    <div class="relative flex h-64 w-full md:h-80 md:w-80 lg:h-84 lg:w-84 aspect-square flex-col items-center justify-center rounded-2xl border border-dashed border-primary/30 bg-gradient-to-br from-primary/10 via-black/50 to-neutral-900/80 p-6 text-center shadow-xl">
                      <div class="mb-3 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/20 text-primary border border-primary/30 shadow-lg shadow-primary/10">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <span class="font-serif text-lg font-semibold text-white">{name}</span>
                      <span class="mt-1 text-xs font-mono text-primary/80">Square Image Reserved</span>
                    </div>
                  )}
                </div>

              </div>
            </div>
          );
        },
      )
    }
  </div>
</Section>
